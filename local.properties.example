# ─────────────────────────────────────────────────────────────────────────
# VaultEx — secrets de build
#
# Copier ce fichier en `local.properties` (à la racine du projet) et y mettre
# les vraies valeurs. `local.properties` est gitignoré : il ne part JAMAIS sur
# GitHub, et c'est le seul endroit où des secrets doivent exister.
#
# POURQUOI : tout ce qui passe par buildConfigField finit dans BuildConfig,
# donc dans le DEX de l'APK. R8 obfusque les noms de classes, PAS le contenu
# des chaînes de caractères. Une clé écrite en dur dans build.gradle.kts est
# récupérable par un simple `strings` sur l'APK distribué.
#
# Toutes ces valeurs sont FACULTATIVES pour compiler : une clé absente vaut
# chaîne vide et la fonctionnalité concernée se désactive proprement.
# ─────────────────────────────────────────────────────────────────────────

# Chemin du SDK Android (généré automatiquement par Android Studio)
#sdk.dir=/chemin/vers/Android/Sdk

# ─── Indispensable au swap ───────────────────────────────────────────────
# Clé partenaire ChangeNOW. Sans elle, aucun échange n'est possible.
# https://changenow.io/affiliate
changenow.key=

# ─── SimpleSwap : le second échangeur ────────────────────────────────────
# ChangeNOW verse 0,4 % au partenaire, sans plus. SimpleSwap laisse fixer ce
# taux entre 0,4 et 5 % SUR LA CLÉ : la commission est prise DANS l'échange,
# sans seconde transaction — la seule façon d'atteindre 1,5 % sans payer des
# frais réseau supérieurs à ce qu'on encaisse.
# https://simpleswap.io → Web Tools → API
simpleswap.key=

# QUEL ÉCHANGEUR RÉPOND. Deux valeurs : « changenow » ou « simpleswap ».
#
# ABSENT = changenow. C'est voulu : aucune version distribuée ne change de
# comportement sans décision écrite, et le retour en arrière tient en un mot.
#
# Les deux maisons n'écrivent PAS les tickers pareil — « usdtbep20 » et
# « bnb-bsc » chez SimpleSwap, « usdtbsc » et « bnbbsc » chez ChangeNOW. Une
# table par fournisseur, dans FournisseurSimpleSwap.kt et
# FournisseurChangeNow.kt. Si un échange échoue avec « Not Found » SANS
# afficher de minimum, c'est le ticker qui est refusé, pas le montant :
# vérifier la table du fournisseur EN SERVICE, pas celle de l'autre.
swap.provider=changenow

# Ce que la clé SimpleSwap prélève réellement, en pourcent. Ne PRÉLÈVE rien —
# la clé s'en charge. Ne sert qu'à AFFICHER le bon chiffre, là où l'écran
# annonçait 1,5 % quand rien n'était pris. À aligner sur le réglage de
# l'espace partenaire, sous peine d'annoncer un frais qui n'est pas celui-là.
simpleswap.commission=1.5

# ─── Historique des transactions ─────────────────────────────────────────
# Etherscan API V2 : une clé couvre Ethereum (les chaînes se distinguent
# par le paramètre chainid, plus par le nom d'hôte). La V1 est désactivée :
# sans clé V2, l'historique ETH reste vide.
# BNB Chain : le forfait gratuit/Demo peut REFUSER cette chaîne
# (« Free API access is not supported for this chain »). Le solde et la
# détection de dépôt BNB restent corrects (RPC direct) ; seul l'historique
# détaillé (vrai hash) nécessite alors un forfait Etherscan payant.
# https://etherscan.io/myapikey
etherscan.key=
bscscan.key=

# ─── Confort (facultatif) ────────────────────────────────────────────────
# CoinGecko Demo, gratuite : supprime quasiment le rate-limit de l'écran Marché.
# https://www.coingecko.com/en/developers/dashboard
coingecko.key=

# TronGrid : améliore les limites de débit (en-tête TRON-PRO-API-KEY).
# https://www.trongrid.io
trongrid.key=

# ─── Monitoring administrateur (facultatif) ──────────────────────────────
# Bot Telegram privé : installations, transactions, plantages, jalons.
# Laisser vide = monitoring désactivé, l'app fonctionne normalement.
#
# ATTENTION : ce token donne le contrôle TOTAL du bot. S'il a déjà été exposé
# (versionné, partagé, publié), le régénérer via @BotFather → /revoke.
telegram.admin.token=
# ID du groupe, NÉGATIF pour un supergroupe (un id positif enverrait en privé).
# Récupérable via https://api.telegram.org/bot<TOKEN>/getUpdates après avoir
# ajouté le bot au groupe et y avoir écrit un message.
telegram.admin.chat=

# ─── Mobile Money (non branché à ce jour) ────────────────────────────────
flutterwave.key=

# ─── Play Integrity (facultatif) ─────────────────────────────────────────
# Numéro de projet Google Cloud. 0 ou absent = désactivé.
play.integrity.project=0

# ─── Anti-repackaging (à renseigner après la première release signée) ────
# Empreinte SHA-256 du certificat de signature. Vide = contrôle inactif.
# Obtenir la valeur :
#   keytool -printcert -jarfile app/build/outputs/apk/release/app-release.apk
# puis copier la ligne « SHA256: » (le format AA:BB:CC… est accepté tel quel).
# Ce qu'elle protège : un faux VaultEx repackagé et rediffusé par WhatsApp ou
# Telegram refusera de s'ouvrir. Voir AppIntegrity.kt.
app.signature.sha256=

# ─── Certificate pinning (release uniquement) ─────────────────────────────
# Vaut true par defaut. Passer a false UNIQUEMENT pour diagnostiquer :
# si les soldes ou les prix restent a zero en release alors que la version
# debug fonctionne, ce sont souvent les empreintes de NetworkModule.CERT_PINS
# qui ne correspondent plus aux certificats reels des serveurs.
# Ne jamais distribuer une version construite avec false.
cert.pinning=true

# ─── Relais de cours (Cloudflare Worker) ──────────────────────────────────
# Le quota gratuit de CoinGecko vaut pour la CLÉ, donc pour TOUTE
# l'application réunie : 10 000 appels par mois. À un millier par téléphone,
# une dizaine d'appareils l'épuisent, et l'API répond alors 429 à tout le
# monde en même temps — plus aucun prix affiché, nulle part.
#
# Le relais pose la question une fois et sert la réponse à tous : le coût
# cesse de dépendre du nombre d'installations. Déploiement (gratuit, sans
# carte bancaire) : voir l'en-tête de tools/relais-cours/worker.js.
#
# VIDE = appel direct à CoinGecko, comportement d'avant. Sans risque.
# Barre oblique finale COMPRISE.
prix.relay.url=

# ─── Numéro de version (facultatif) ───────────────────────────────────────
# Normalement CALCULÉ à partir du nombre de commits git : il augmente tout
# seul, sans rien à penser. Ce réglage n'existe que pour les machines sans
# dépôt git (archive du projet, intégration continue).
#
# Ce numéro est ce qui dit à Android qu'un paquet est plus récent que celui
# installé. S'il ne change pas, beaucoup d'installateurs affichent
# « installé » SANS rien remplacer — la mise à jour semble ne rien changer,
# et il faut désinstaller pour que le nouveau code s'applique.
#
# Si tu le renseignes : N doit être STRICTEMENT SUPÉRIEUR au numéro du
# dernier APK distribué. Un numéro plus bas fait refuser l'installation.
version.code=
