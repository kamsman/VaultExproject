+    /**
+     * Adresse venant du SCANNER — sélectionne aussi une chaîne compatible.
+     *
+     * ═══════════════════════════════════════════════════════════════════
+     * POURQUOI CE CHEMIN EST DISTINCT DE [setToAddress]
+     * ═══════════════════════════════════════════════════════════════════
+     *
+     * L'écran Envoyer s'ouvre sur USDT (TRC20) par défaut. Un scan depuis
+     * l'accueil y arrivait donc avec l'adresse remplie… et cette monnaie-là
+     * sélectionnée, quelle que soit l'adresse lue. Scanner une adresse
+     * Ethereum proposait d'envoyer de l'USDT-TRC20 dessus.
+     *
+     * Une saisie au clavier ne pose pas ce problème : on choisit la monnaie
+     * AVANT de taper l'adresse. Un scan inverse l'ordre — l'adresse arrive
+     * d'un coup, sans qu'aucune monnaie ait été choisie. C'est donc au code
+     * de déduire la chaîne, puisque le format de l'adresse la désigne.
+     *
+     * ON NE CHANGE PAS UN CHOIX DÉLIBÉRÉ. Si l'adresse scannée convient à la
+     * monnaie déjà sélectionnée, rien n'est touché : quelqu'un qui a choisi
+     * BNB puis scanne une adresse 0x veut envoyer du BNB, pas de l'ETH.
+     * On ne corrige que l'incompatibilité.
+     */
+    private fun setScannedAddress(address: String) {
+        val s = _state.value
+        val compatible =
+            if (s.customToken != null) AddressValidator.isValidEvm(address)
+            else AddressValidator.isValid(address, s.selectedChain)
+        if (!compatible) chaineDeduite(address)?.let { setChain(it) }
+        setToAddress(address)
+    }
+
+    /**
+     * Adresse déposée par le scanner AVANT l'ouverture de cet écran.
+     *
+     * Le scanner écrit dans le `SavedStateHandle` de l'entrée de navigation
+     * « Envoyer », et Hilt remet ce même handle à ce ViewModel : on peut donc
+     * lire l'adresse ICI, avant que l'écran ne s'affiche, et choisir la
+     * chaîne en conséquence.
+     *
+     * Faire ce travail dans le ViewModel plutôt que dans l'écran a une raison
+     * simple : c'est le seul endroit qui sait quelle monnaie est sélectionnée
+     * et peut en changer. L'écran, lui, ne fait que transmettre.
+     *
+     * La clé n'est PAS consommée ici : l'écran la lit ensuite de son côté et
+     * s'en charge. Il rappellera `setToAddress` avec la même adresse, ce qui
+     * ne change rien — la chaîne, elle, aura déjà été fixée.
+     */
+    private fun appliquerAdresseScannee(handle: SavedStateHandle) {
+        val adresse = handle.get<String>(com.vaultex.ui.screens.scanner.SCANNED_ADDRESS_KEY)
+        if (!adresse.isNullOrBlank()) setScannedAddress(adresse)
+    }
